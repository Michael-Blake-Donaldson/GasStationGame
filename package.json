{
  "name": "gas-station-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "node scripts/tauri-build.mjs",
    "build:installer": "node scripts/tauri-build.mjs --bundle",
    "check:desktop": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --locked",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:all": "pnpm verify && pnpm test:coverage && pnpm format:rust:check && pnpm lint:rust && pnpm test:rust && pnpm check:desktop && pnpm build:desktop",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
